# Template für scripts/provision-customer.sh
# Nutzung: cp provision.env.example provision.env  # Werte anpassen! (provision.env niemals committen)

# Zentralserver (Lizenz/Analytics) — aktuell Render-Interim
CENTRAL_URL=https://kassensystem-8vl2.onrender.com

# Developer-Account auf dem Zentralserver (für POST /api/license/keys)
DEV_USERNAME=developer
DEV_PASSWORD=change-me

# Öffentlicher Host des VPS (für den Aktivierungs-Link in der Ausgabe)
PUBLIC_HOST=localhost

# OTA Update-Upload Key (für scripts/deploy-ota.sh → POST /api/app-version/upload)
# Generieren: openssl rand -hex 32
OTA_UPLOAD_KEY=change-me
