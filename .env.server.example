# Template für den VPS-Stack mit Domain (docker-compose.server.yml)
# Nutzung:
#   cp .env.server.example .env.server   # Werte anpassen!
#   docker compose --env-file .env.server -f docker-compose.server.yml up -d --build
#
# .env.server niemals committen (in .gitignore).

# Domains (DNS bei site.de vorher auf die Server-IP zeigen lassen!)
DOMAIN=moncomptoir.bj
APP_DOMAIN=app.moncomptoir.bj

# Compose-interne Datenbank
POSTGRES_USER=posuser
POSTGRES_PASSWORD=change-me-random
POSTGRES_DB=posdb

# JWT
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=8h
