# Template für den Produktiv-Stack (docker-compose.prod.yml)
# Nutzung:
#   cp .env.production.example .env.production   # Werte anpassen!
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
# Oder automatisiert pro Kunde: scripts/provision-customer.sh <kunde> <plan> [tage] [port]
#
# .env.production niemals committen (in .gitignore).

# Kundenname (Compose-Projektname: kassensystem-<CUSTOMER>)
CUSTOMER=demo

# Host-Port, auf dem die App erreichbar ist (pro Kunde eindeutig!)
APP_PORT=5000

# Compose-interne Datenbank
POSTGRES_USER=posuser
POSTGRES_PASSWORD=change-me-random
POSTGRES_DB=posdb

# JWT
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=8h
# Kommagetrennte erlaubte Browser-Origins (Capacitor-WebView + localhost immer erlaubt)
CORS_ORIGIN=https://app.moncomptoir.bj
